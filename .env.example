# ── Database (shared by packages/db + packages/auth + apps/api) ────────────
DATABASE_URL=postgres://neuronexus:neuronexus@localhost:5432/neuronexus

# Used by `bun test` — separate DB so tests can wipe tables between runs
# without touching dev data.
TEST_DATABASE_URL=postgres://neuronexus:neuronexus@localhost:5432/neuronexus_test

# ── BetterAuth ─────────────────────────────────────────────────────────────
# `openssl rand -base64 32` to generate
BETTER_AUTH_SECRET=change-me-in-production-please-32chars
BETTER_AUTH_URL=http://localhost:3000

# ── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
WEB_ORIGIN=http://localhost:3001
# Production logs are one JSON object per line. Defaults: debug in dev, info in
# production, silent in tests.
# LOG_LEVEL=info
# One absolute shutdown budget shared by the listener, every worker, and the DB.
# Must be positive and shorter than the container stop grace (10s in Compose).
SHUTDOWN_TIMEOUT_MS=8000

# ── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email (optional) ───────────────────────────────────────────────────────
# If RESEND_API_KEY is unset, the api logs emails to stdout (dev-friendly).
# In prod set both to send real password-reset mail.
# RESEND_API_KEY=
# Recommended once the mailbox and SPF exist: EMAIL_FROM="Reomi <noreply@reomi.ru>"
# Leave it unset until then. Empty EMAIL_FROM stays NeuroNexus <noreply@neuronexus.app>;
# the application does not substitute noreply@reomi.ru by itself.
# EMAIL_FROM="Reomi <noreply@reomi.ru>"

# ── Study reminders / Web Push (optional) ─────────────────────────────────
# No Firebase project and no gcm_sender_id. Generate a pair with
# `npx web-push generate-vapid-keys` and set both keys on the API.
# Without them, POST /profile/push-subscriptions returns 503 push_disabled
# and the rest of the API keeps working. VAPID_SUBJECT is a mailto: or https URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://app.reomi.ru

# ── Media storage (M2) — local MinIO defaults; prod = Cloudflare R2 / AWS S3 ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=neuronexus-media
S3_ACCESS_KEY_ID=neuronexus
S3_SECRET_ACCESS_KEY=neuronexus-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/neuronexus-media
S3_FORCE_PATH_STYLE=true
MAX_MEDIA_BYTES=5242880
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/neuronexus-media
# Hourly cleanup of abandoned uploads and unreferenced images.
# Off unless MEDIA_GC_ENABLED=true. Set that on the Coolify API service
# after deploy to turn the loop on. Any other value leaves objects in place.
# Account deletion still removes that user's objects without this flag.
# A failed object list logs media.gc.list_failed and does not log media.gc.completed.
# Already deleted objects are not restored.
# MEDIA_GC_ENABLED=true
# MEDIA_GC_INTERVAL_MS=3600000
# MEDIA_PENDING_MAX_AGE_MS=86400000
# MEDIA_UNREFERENCED_MAX_AGE_MS=604800000
# MEDIA_GC_BATCH=50

# ── AI / RAG (optional) ──────────────────────────────────────────────────────
# All vars below are OPTIONAL — leave unset to disable AI features. The app
# degrades, never crashes: with no keys the index queue no-ops, `/chat` shows a
# setup notice, and the rest of the app is unaffected. NEVER expose these as
# NEXT_PUBLIC_* — they are server-only secrets.
#
# There are TWO INDEPENDENT switches:
#   * embeddings/indexing → enabled when OPENAI_API_KEY is set AND
#     INDEXING_ENABLED != 'false'
#   * chat → enabled when CHAT_API_KEY is set
# so you can run chat (degraded retrieval) without indexing, or pause indexing
# without breaking thread reads.
#
# Embeddings (indexing side):
# OPENAI_API_KEY=
# EMBEDDING_BASE_URL is SEPARATE from CHAT_BASE_URL — the embedder may run on a
# different host/provider than the chat gateway. Defaults to OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_PROXY_URL — OPTIONAL egress proxy for embedding calls ONLY, when
# the embedding provider is geo-blocked from the server. http(s):// proxies
# only (Bun fetch has no SOCKS support — point this at a socks5→http converter
# sidecar such as gost). Chat / web-search / S3 traffic is NOT proxied.
# EMBEDDING_PROXY_URL=http://neuronexus-emb-proxy:8118
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM must match the model (text-embedding-3-small = 1536). Changing
# it requires the reindex-on-model-change runbook (see CLAUDE.md → AI / RAG):
# regenerate the migration + reindex.
# NOTE: changing this alone disables embeddings until you regenerate the migration + reindex.
# EMBEDDING_DIM=1536
# Pause indexing without unsetting the key (default true):
# INDEXING_ENABLED=true
#
# Chat (OpenAI-compatible completion endpoint):
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_API_KEY may equal OPENAI_API_KEY:
# CHAT_API_KEY=
#
# CHAT_MODELS — OPTIONAL per-turn model/reasoning picker allow-list. CSV where
# each entry is `model` or `model|label`; the FIRST entry is the default. Your
# gateway encodes the reasoning level in the model NAME, so you own the mapping.
# Unset ⇒ the picker is hidden and chat uses CHAT_MODEL exactly as today. Only
# the parsed {id,label,default} is exposed via GET /ai/status — never a secret.
# Example (placeholder ids — replace with your gateway's model names):
# CHAT_MODELS=gpt-5.5none|Быстро,gpt-5.5medium|Сбалансированно,gpt-5.5high|Глубоко
#
# Retrieval tuning (chat grounding):
#  * RETRIEVE_K — max card chunks pulled per chat turn (default 12).
#  * RETRIEVE_MIN_SCORE — min cosine similarity (0..1) a chunk must clear to be
#    used (default 0.32). Below it the chunk is dropped, so an off-topic message
#    (e.g. a greeting) pulls 0 cards instead of k irrelevant ones. Lower → more
#    inclusive; raise → stricter. Calibrated for text-embedding-3-small.
# RETRIEVE_K=12
# RETRIEVE_MIN_SCORE=0.32
#
# Agentic tool-calling chat:
#  * BRAVE_SEARCH_API_KEY — OPTIONAL. When set, the chat agent may call a
#    `web_search` tool (Brave Web Search API). Absent ⇒ the tool is simply not
#    offered to the model; chat works unchanged.
#  * EXA_API_KEY — OPTIONAL (deep research). When set, Exa (exa.ai) becomes the
#    web-search provider (preferred over Brave) AND the backend for the
#    `fetch_page` tool — Exa /contents crawls pages on THEIR network and
#    returns clean text, so the API server never fetches arbitrary URLs itself.
#  * CHAT_FETCH_PAGE — set 'false' to remove the `fetch_page` tool entirely.
#    Without an Exa key the tool uses a direct SSRF-guarded fetcher.
#  * FETCH_PAGE_TIMEOUT_MS / FETCH_PAGE_MAX_BYTES — fetch_page hard timeout
#    (default 10000; also Exa's livecrawlTimeout) and the direct fetcher's
#    response byte cap (default 2000000).
#  * AGENT_MAX_STEPS — hard ceiling on agent loop iterations (default 8). The
#    cap is loop-enforced; the final step forces a tool-free answer.
#  * WEB_SEARCH_TIMEOUT_MS — per web_search call hard timeout (default 7000).
#  * TOOL_RESULT_MAX_CHARS — per tool-result content cap, chars (default 4000).
#  * TOOL_RESULT_BUDGET_FACTOR — per-turn tool-result budget =
#    TOOL_RESULT_MAX_CHARS × factor (default 8); deep-research turns read
#    several page slices before the loop forces a final answer.
#  * RESEARCH_MAX_STEPS / RESEARCH_TOOL_RESULT_BUDGET_FACTOR — raised caps for
#    a turn sent with the composer's deep-research MODE toggle (defaults 16/16).
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# CHAT_FETCH_PAGE=true
# FETCH_PAGE_TIMEOUT_MS=10000
# YouTube library sources need no API key. Caption download on the Data API
# requires OAuth, so a key would not unlock transcripts. The server reads the
# watch page and timedtext itself. YOUTUBE_FETCH_TIMEOUT_MS bounds each request
# (default 20000) so a slow or blocked YouTube host releases the ingest queue.
# YOUTUBE_FETCH_TIMEOUT_MS=20000
# FETCH_PAGE_MAX_BYTES=2000000
# AGENT_MAX_STEPS=8
# WEB_SEARCH_TIMEOUT_MS=7000
# TOOL_RESULT_MAX_CHARS=4000
# TOOL_RESULT_BUDGET_FACTOR=8
# RESEARCH_MAX_STEPS=16
# RESEARCH_TOOL_RESULT_BUDGET_FACTOR=16
#
# Agentic environment tunables (all OPTIONAL):
#  * CHAT_STREAM_USAGE — set 'false' if your gateway rejects
#    `stream_options: { include_usage: true }`; disables token accounting.
#  * CHAT_TITLE_TIMEOUT_MS — auto-title generation timeout (default 10000).
#  * CHAT_COMPRESS_THRESHOLD / CHAT_COMPRESS_KEEP — long conversations beyond
#    THRESHOLD rows replay a cached summary + the last KEEP rows instead of the
#    full verbatim history (defaults 80 / 30).
#  * CHAT_SUMMARY_TIMEOUT_MS — summarization call timeout (default 8000);
#    failure falls back to verbatim history.
#  * CHAT_VISION — set 'false' if your model/gateway rejects multimodal
#    image_url content parts; hides the image-attachment affordance and replays
#    images as text placeholders (text-file attachments are unaffected).
# CHAT_STREAM_USAGE=true
# CHAT_TITLE_TIMEOUT_MS=10000
# CHAT_COMPRESS_THRESHOLD=80
# CHAT_COMPRESS_KEEP=30
# CHAT_SUMMARY_TIMEOUT_MS=8000
# CHAT_VISION=true
#
# ── NotebookLM sources (M1) — all OPTIONAL ───────────────────────────────────
#  * MAX_SOURCE_BYTES — per-file upload ceiling in bytes (default 25 MiB).
#  * MAX_SOURCE_CHUNKS — max chunks per source before ingest errors with
#    too_many_chunks (default 1500). Bounds paid-embedding cost per file.
#  * MAX_SOURCE_DECOMPRESSED_BYTES — EPUB zip-bomb guard: max total decompressed
#    archive size in bytes (default 200 MiB). A compliant EPUB is well under this.
#  * MAX_SOURCES_PER_NOTEBOOK — aggregate source cap per notebook (default 50).
#  * MAX_NOTEBOOKS_PER_USER — aggregate notebook cap per user (default 25).
#  * SOURCE_INGEST_CONCURRENCY — async ingest worker concurrency (default 1).
#    Serial keeps embedding calls bounded; raise for multi-core/fast gateways.
#  * SOURCE_CHUNK_TOKENS — token target per document chunk (default 800).
#    Uses a chars/4 heuristic; tune for your embedding model's context window.
#  * SOURCE_CHUNK_OVERLAP — fractional overlap between adjacent chunks,
#    clamped to [0, 0.5] (default 0.12, i.e. 12 %).
# MAX_SOURCE_BYTES=26214400
# MAX_SOURCE_CHUNKS=1500
# MAX_SOURCE_DECOMPRESSED_BYTES=209715200
# MAX_SOURCES_PER_NOTEBOOK=50
# MAX_NOTEBOOKS_PER_USER=25
# SOURCE_INGEST_CONCURRENCY=1
# SOURCE_CHUNK_TOKENS=800
# SOURCE_CHUNK_OVERLAP=0.12
