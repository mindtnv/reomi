{
  "name": "@reomi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "predb:push": "NODE_ENV=test bun --env-file=../../.env run src/ensure-vector-cli.ts",
    "db:push": "NODE_ENV=test DRIZZLE_COMMAND=push drizzle-kit push --force",
    "predb:push:test": "NODE_ENV=test bun --env-file=../../.env run src/ensure-vector-cli.ts",
    "db:push:test": "NODE_ENV=test DRIZZLE_COMMAND=push drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:apply": "bun --env-file=../../.env run src/migrate.ts",
    "db:migrate:apply:test": "NODE_ENV=test bun --env-file=../../.env run src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reomi/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@reomi/auth": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
