{
  "description": "Project-scoped Hindsight memory for Reomi.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.hindsight/coding-agents/dist/codex-sessionstart-hook.js\"",
            "timeout": 30,
            "statusMessage": "Loading Reomi memory",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.hindsight/coding-agents/dist/codex-hook.js\"",
            "timeout": 30,
            "statusMessage": "Recalling Reomi memory",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.hindsight/coding-agents/dist/codex-stop-hook.js\"",
            "timeout": 60,
            "statusMessage": "Retaining Reomi session"
          }
        ]
      }
    ]
  }
}
