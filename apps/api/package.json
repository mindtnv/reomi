{
  "name": "@reomi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "test": "NODE_ENV=test bun --env-file=../../.env test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-presigned-post": "^3.1136.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@reomi/auth": "workspace:*",
    "@reomi/db": "workspace:*",
    "@reomi/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sanitize-html": "^2.17.7",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2"
  }
}
