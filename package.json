{
  "name": "neuronexus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "dev:web": "bun run --filter @neuronexus/web dev",
    "dev:api": "bun run --filter @neuronexus/api dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "NODE_ENV=test bun --env-file=./.env test",
    "test:ci": "NODE_ENV=test bun --env-file=./.env test",
    "test:s3:ci": "NODE_ENV=test S3_INTEGRATION_REQUIRED=true bun --env-file=./.env test apps/api/tests/media.test.ts apps/api/tests/source-dedup.test.ts",
    "test:unit": "NODE_ENV=test bun --env-file=./.env test packages/shared",
    "test:api": "NODE_ENV=test bun --env-file=./.env test apps/api",
    "pretest": "bun run db:migrate:apply:test",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "db:push": "bun run --filter @neuronexus/db db:push",
    "db:push:test": "bun run --filter @neuronexus/db db:push:test",
    "db:migrate:apply": "bun run --filter @neuronexus/db db:migrate:apply",
    "db:migrate:apply:test": "bun run --filter @neuronexus/db db:migrate:apply:test",
    "db:generate": "bun run --filter @neuronexus/db db:generate",
    "db:migrate": "bun run --filter @neuronexus/db db:migrate",
    "db:seed": "bun run --filter @neuronexus/db db:seed",
    "db:studio": "bun run --filter @neuronexus/db db:studio",
    "mcp:smoke": "bun apps/api/scripts/mcp-smoke.ts",
    "mcp:stdio": "bun apps/api/scripts/mcp-stdio.ts",
    "dev:design": "bun --env-file=.env.design apps/web/scripts/design-preview.mjs",
    "db:seed:design": "bun --env-file=.env.design packages/db/src/seed-design.ts"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.2",
    "nanoid": "6.0.1",
    "postcss": "8.5.28",
    "shell-quote": "1.10.0",
    "sharp": "0.35.4",
    "browserslist": "4.29.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
